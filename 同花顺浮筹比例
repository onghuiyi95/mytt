日换手率:SUM(VOL,1)*100/CAPITAL,colorf0f000,LINETHICK0 ;
VARQS1:=100*VOL/CAPITAL;
VARQS2:=100*(WINNER(CLOSE)-REF(WINNER(CLOSE),1));
穿透率:=VARQS2/VARQS1,VOLSTICK;
浮筹比例:(winner(c*1.1)-winner(c*0.9))/winner(hhv(h,0))*100,LINETHICK2;
PARTLINE(浮筹比例<REF(浮筹比例,1),浮筹比例),LINETHICK2,colorFFFFFF;

EE2:=WINNER(1.05*CLOSE)*100-WINNER(0.95*CLOSE)*100,LINETHICK0;
获利:MA(WINNER(0.95*CLOSE)*100-WINNER(COST(0))*100,1),LINETHICK0;
套牢:MA(WINNER(COST(100))*100-WINNER(1.05*CLOSE)*100,1),LINETHICK0;
浮动:=MA(EE2,1),LINETHICK0;
集中度70%:(COST(85)-COST(15))/(COST(85)+COST(15))*100,ColorFF00FF,LINETHICK0;
集中度90%:(COST(95)-COST(5))/(COST(95)+COST(5))*100,LINETHICK0;
